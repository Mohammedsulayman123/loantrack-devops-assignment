# ==============================================================================
# Environment Configuration Template for LoanTrack
# Copy this file to '.env' before running docker compose:
#   cp .env.example .env
# NOTE: Never commit '.env' containing real secrets to version control.
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=loantrack
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_example_password_change_me
POSTGRES_PORT=5432

# Backend Microservice Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=loantrack
DB_USER=postgres
DB_PASSWORD=postgres_example_password_change_me
PORT=8000

# Port Mappings on Host
FRONTEND_PORT=3000
BACKEND_PORT=8000
